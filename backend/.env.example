# Ejemplo de .env , estos campos necesitas con tus credenciales para conectar el firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── IA: Google Gemini ──
# ESTE es el proveedor real de Foco. Todo /api/ai/* (chat, asistencia en ensayo,
# revisión post-entrega, orientación vocacional, análisis y recomendaciones) usa
# el modelo `gemini-2.5-flash` vía @google/generative-ai. Sin esta clave, el
# AiFeedbackService arranca deshabilitado y todos los endpoints de IA fallan.
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — NO SE USA. El paquete `openai` sigue instalado y esta variable
# quedó de una implementación anterior, pero ningún archivo del backend la lee.
# Se puede dejar vacía sin ningún efecto.
OPENAI_API_KEY=

# ── Cloudinary ──
# Usado solo por los scripts manuales de subida de imágenes/gifs
# (src/scripts/*cloudinary*, upload-*.ts). NO se usa en runtime de la API.
# Son OBLIGATORIAS para correr esos scripts: ya no hay credenciales por defecto
# en el código — si faltan, el script aborta con un mensaje claro.
# El secreto anterior quedó expuesto en el historial de git: hay que ROTARLO en
# https://console.cloudinary.com/ (Settings → API Keys) y pegar el nuevo acá.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Flow (flow.cl) — pasarela de pago con suscripciones recurrentes ──
# A diferencia de Transbank, Flow NO ofrece credenciales de sandbox públicas:
# cada comercio debe crear su propia cuenta de pruebas en sandbox.flow.cl y
# sacar su propio API Key + Secret Key desde ahí (Mi Cuenta → API Keys).
# Sin estas dos variables, todos los endpoints de Flow fallan con un error
# claro — no hay ningún fallback silencioso.
FLOW_ENVIRONMENT=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Opcional: solo si necesitas forzar una URL base distinta a la estándar de Flow
FLOW_BASE_URL=

# IDs de los planes recurrentes en Flow (mensual / anual). Se generan UNA VEZ
# corriendo `npm run setup:flow-plans` (backend/src/scripts/setup-flow-plans.ts)
# y se pegan acá — el backend nunca crea planes por su cuenta en tiempo real.
FLOW_PLAN_ID_MONTHLY=
FLOW_PLAN_ID_YEARLY=

# URL pública HTTPS del backend (sin path), usada como urlCallback para que
# Flow pueda avisarnos de cada cobro recurrente. Flow no puede llamar a
# localhost — en desarrollo usa un túnel (ngrok) y pon aquí esa URL.
BACKEND_PUBLIC_URL=

# ── Servidor ──
# Puerto de la API. Por defecto 3000 (debe coincidir con el apiUrl de
# frontend-app/src/environments/environment*.ts).
PORT=3000

# Orígenes permitidos por CORS (main.ts). En desarrollo el default ya sirve.
FRONTEND_APP_URL=http://localhost:4200
# Legacy: el landing dejó de ser un proyecto aparte y ahora vive dentro de la
# app Angular. Se mantiene solo porque main.ts todavía lo lee para el CORS.
FRONTEND_LANDING_URL=http://localhost:3001

# ── Emuladores de Firebase (opcional, solo desarrollo local) ──
# Si las defines, el Admin SDK apunta a los emuladores en vez de a producción.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099