# Ejemplo de .env , estos campos necesitas con tus credenciales para conectar el firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI (usado por /api/ai/*: recomendaciones, análisis de ensayos, asistencia)
OPENAI_API_KEY=

# Cloudinary (scripts de src/scripts/*cloudinary* para subir imágenes/gifs).
# Si las dejas vacías, los scripts caen de vuelta a las credenciales actuales
# (ya expuestas en git). Para rotar la API secret: genera una nueva en el
# dashboard de Cloudinary y complétala aquí.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Webpay Plus (Transbank) ──
# Si dejas estas 3 vacías, el backend usa automáticamente las credenciales de
# INTEGRACIÓN/PRUEBA públicas de Transbank (modo test), tal como está hoy.
#
# Para pasar a producción cuando ya tengas el comercio afiliado a Transbank:
#   1. WEBPAY_ENVIRONMENT=production
#   2. WEBPAY_COMMERCE_CODE=<tu código de comercio real>
#   3. WEBPAY_API_KEY=<tu API key real>
# No hay que tocar código: webpay.service.ts lee estas variables y cambia
# automáticamente la URL base a la de producción de Transbank.
WEBPAY_ENVIRONMENT=test
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# Opcional: solo si necesitas forzar una URL base distinta a la estándar de Transbank
WEBPAY_BASE_URL=