# Ejemplo de .env , estos campos necesitas con tus credenciales para conectar el firebase
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │  PARA UN DESPLIEGUE A PRODUCCION (desplegar-backend.bat / Cloud Run):       │
# │  El deploy usa `gcloud run deploy --env-vars-file`, que REEMPLAZA todas     │
# │  las variables del servicio (no las fusiona). El .env que uses al           │
# │  desplegar TIENE que tener TODAS estas, o las que falten desaparecen del    │
# │  Cloud Run y se rompen Foco / pagos / Firebase Admin sin dar error:         │
# │    FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY,        │
# │    GEMINI_API_KEY, FLOW_ENVIRONMENT=production, FLOW_API_KEY,               │
# │    FLOW_SECRET_KEY, BACKEND_PUBLIC_URL=https://estudiauni.cl,              │
# │    TURNSTILE_SECRET_KEY                                                    │
# │  Y las credenciales de Flow de produccion salen de www.flow.cl,            │
# │  NO de sandbox.flow.cl (son cuentas distintas).                            │
# └───────────────────────────────────────────────────────────────────────────┘
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── IA: Google Gemini ──
# ESTE es el proveedor real de Foco. Todo /api/ai/* (chat, asistencia en ensayo,
# revisión post-entrega, orientación vocacional, análisis y recomendaciones) usa
# el modelo `gemini-2.5-flash` vía @google/generative-ai. Sin esta clave, el
# AiFeedbackService arranca deshabilitado y todos los endpoints de IA fallan.
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI — NO SE USA. El paquete `openai` sigue instalado y esta variable
# quedó de una implementación anterior, pero ningún archivo del backend la lee.
# Se puede dejar vacía sin ningún efecto.
OPENAI_API_KEY=

# ── Cloudinary ──
# Usado solo por los scripts manuales de subida de imágenes/gifs
# (src/scripts/*cloudinary*, upload-*.ts). NO se usa en runtime de la API.
# Son OBLIGATORIAS para correr esos scripts: ya no hay credenciales por defecto
# en el código — si faltan, el script aborta con un mensaje claro.
# El secreto anterior quedó expuesto en el historial de git: hay que ROTARLO en
# https://console.cloudinary.com/ (Settings → API Keys) y pegar el nuevo acá.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Flow (flow.cl) — pagos ÚNICOS (pases de 1 mes / 1 año, sin renovación) ──
# A diferencia de Transbank, Flow NO ofrece credenciales de sandbox públicas:
# cada comercio debe crear su propia cuenta de pruebas en sandbox.flow.cl y
# sacar su propio API Key + Secret Key desde ahí (Mi Cuenta → API Keys).
# Sin estas dos variables, todos los endpoints de Flow fallan con un error
# claro — no hay ningún fallback silencioso.
#
# EN PRODUCCION: FLOW_ENVIRONMENT=production, y FLOW_API_KEY/FLOW_SECRET_KEY tienen
# que ser las de tu cuenta de www.flow.cl (Mi Cuenta → API Keys), NO las de
# sandbox.flow.cl. Un solo carácter mal copiado en la API key → "apiKey not found".
FLOW_ENVIRONMENT=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Opcional: solo si necesitas forzar una URL base distinta a la estándar de Flow
FLOW_BASE_URL=

# URL pública HTTPS del backend (sin path), usada como urlConfirmation (el
# webhook que Flow llama server-to-server tras cada pago). Flow no puede
# llamar a localhost — en desarrollo usa un túnel (cloudflared) y pon aquí esa
# URL. NO hace falta correr ningún script de setup: cada pago crea su propia
# orden en Flow al momento (POST /payment/create), no hay "planes" que
# precrear como en el viejo modelo de suscripción recurrente.
BACKEND_PUBLIC_URL=

# ── App Check (Cloudflare Turnstile) ──
# La SECRET key (no el sitekey, ese va en el frontend) que te dio Cloudflare al crear el
# widget de Turnstile. La usa AppCheckService (src/app-check/) para verificar el token del
# visitante contra Cloudflare antes de emitir un token de Firebase App Check. Reemplaza a la
# extensión oficial de Firebase, que a la fecha no se puede instalar (su runtime nodejs18 fue
# dado de baja por Google Cloud y Cloudflare aún no republicó una versión corregida).
TURNSTILE_SECRET_KEY=
# Firebase App Id de la app web (el mismo valor que appId en
# frontend-app/src/environments/environment*.ts). Es público, no un secreto — se puede dejar
# vacío y AppCheckService usa el valor real del proyecto como respaldo.
FIREBASE_APP_ID=1:976475724065:web:586b9c2609d84674158660

# ── Servidor ──
# Puerto de la API. Por defecto 3000 (debe coincidir con el apiUrl de
# frontend-app/src/environments/environment*.ts).
PORT=3000

# Orígenes permitidos por CORS (main.ts). En desarrollo el default ya sirve.
# EN PRODUCCION: FRONTEND_APP_URL=https://estudiauni.cl,https://estudiauni.web.app
# (acepta varios separados por coma). A través del rewrite /api/** la petición es
# del mismo origen y CORS ni entra en juego, pero conviene tenerlo bien por si se
# llama la URL de Cloud Run directamente.
FRONTEND_APP_URL=http://localhost:4200
# Legacy: el landing dejó de ser un proyecto aparte y ahora vive dentro de la
# app Angular. Se mantiene solo porque main.ts todavía lo lee para el CORS.
FRONTEND_LANDING_URL=http://localhost:3001

# ── Emuladores de Firebase (opcional, solo desarrollo local) ──
# Si las defines, el Admin SDK apunta a los emuladores en vez de a producción.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099