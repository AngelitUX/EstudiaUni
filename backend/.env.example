# Ejemplo de .env , estos campos necesitas con tus credenciales para conectar el firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI (usado por /api/ai/*: recomendaciones, análisis de ensayos, asistencia)
OPENAI_API_KEY=

# Cloudinary (scripts de src/scripts/*cloudinary* para subir imágenes/gifs).
# Si las dejas vacías, los scripts caen de vuelta a las credenciales actuales
# (ya expuestas en git). Para rotar la API secret: genera una nueva en el
# dashboard de Cloudinary y complétala aquí.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Flow (flow.cl) — pasarela de pago con suscripciones recurrentes ──
# A diferencia de Transbank, Flow NO ofrece credenciales de sandbox públicas:
# cada comercio debe crear su propia cuenta de pruebas en sandbox.flow.cl y
# sacar su propio API Key + Secret Key desde ahí (Mi Cuenta → API Keys).
# Sin estas dos variables, todos los endpoints de Flow fallan con un error
# claro — no hay ningún fallback silencioso.
FLOW_ENVIRONMENT=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Opcional: solo si necesitas forzar una URL base distinta a la estándar de Flow
FLOW_BASE_URL=

# IDs de los planes recurrentes en Flow (mensual / anual). Se generan UNA VEZ
# corriendo `npm run setup:flow-plans` (backend/src/scripts/setup-flow-plans.ts)
# y se pegan acá — el backend nunca crea planes por su cuenta en tiempo real.
FLOW_PLAN_ID_MONTHLY=
FLOW_PLAN_ID_YEARLY=

# URL pública HTTPS del backend (sin path), usada como urlCallback para que
# Flow pueda avisarnos de cada cobro recurrente. Flow no puede llamar a
# localhost — en desarrollo usa un túnel (ngrok) y pon aquí esa URL.
BACKEND_PUBLIC_URL=