rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============ FUNCIONES HELPER ============
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ============ USUARIOS ============
    match /users/{userId} {
      // Los usuarios autenticados pueden leer perfiles
      allow read: if isAuthenticated();

      // Al crear su propio perfil, el usuario NO puede autoasignarse plan/subscription/dailyCredits
      // (esos campos sólo los escribe el backend con Admin SDK, que no pasa por estas reglas)
      allow create: if isOwner(userId) &&
        !('plan' in request.resource.data) &&
        !('subscription' in request.resource.data) &&
        !('dailyCredits' in request.resource.data);

      // Admin (o backend vía Admin SDK) puede escribir cualquier campo.
      // El propio usuario sólo puede actualizar su perfil si NO toca los campos
      // que controlan su nivel de suscripción/créditos, salvo las dos excepciones
      // controladas abajo (cancelar suscripción, y marcar el cooldown de 48h).
      allow update: if isAdmin() || (isOwner(userId) && isValidSelfUpdate());

      function isValidSelfUpdate() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return !changedKeys.hasAny(['plan', 'dailyCredits']) &&
          isValidSubscriptionChange(changedKeys) &&
          isValidCooldownChange(changedKeys);
      }

      // Únicamente permite pasar subscription.status a 'cancelled', sin tocar
      // tier/fechas (evita que un usuario se autoasigne o extienda Plan PRO).
      function isValidSubscriptionChange(changedKeys) {
        let oldSub = resource.data.get('subscription', {});
        let newSub = request.resource.data.get('subscription', {});
        return !changedKeys.hasAny(['subscription']) || (
          newSub.get('tier', null) == oldSub.get('tier', null) &&
          newSub.get('endDate', null) == oldSub.get('endDate', null) &&
          newSub.get('startDate', null) == oldSub.get('startDate', null) &&
          newSub.get('status', null) == 'cancelled'
        );
      }

      // lastSimulationFinishedAt sólo puede fijarse a "ahora" (con tolerancia de reloj).
      // Así el cliente puede iniciar su propio cooldown de 48h al terminar/salir de un
      // ensayo real, pero no puede retroceder la fecha para saltarse el cooldown.
      function isValidCooldownChange(changedKeys) {
        return !changedKeys.hasAny(['lastSimulationFinishedAt']) || (
          request.resource.data.lastSimulationFinishedAt is timestamp &&
          request.resource.data.lastSimulationFinishedAt <= request.time + duration.value(2, 'm') &&
          request.resource.data.lastSimulationFinishedAt >= request.time - duration.value(10, 'm')
        );
      }

      // Subcolección de actividades de estudio
      match /actividad/{actividadId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // ============ ENSAYOS ============
    match /ensayos/{ensayoId} {
      // Todos los usuarios autenticados pueden ver los ensayos disponibles
      allow read: if isAuthenticated();
      // Solo admins pueden crear/editar ensayos
      allow write: if isAdmin();
    }
    
    // ============ PREGUNTAS ============
    match /preguntas/{preguntaId} {
      // Los usuarios autenticados pueden leer las preguntas
      // NOTA: En producción, podrías querer ocultar correctAnswer
      // Por ahora lo dejamos legible para que funcione el frontend
      allow read: if isAuthenticated();
      // Solo admins pueden crear/editar preguntas
      allow write: if isAdmin();
    }
    
    // ============ POOL DE PREGUNTAS ============
    match /pool_preguntas/{preguntaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ============ INTENTOS ============
    match /intentos/{intentoId} {
      // El usuario puede leer y escribir solo SUS propios intentos
      allow read: if isAuthenticated() && resource.data.odId == request.auth.uid;

      allow create: if isAuthenticated() &&
        request.resource.data.odId == request.auth.uid &&
        request.resource.data.status == 'in_progress';

      allow update: if isAuthenticated() &&
        resource.data.odId == request.auth.uid &&
        isValidIntentoUpdate();

      allow delete: if false; // No se pueden borrar intentos

      function isValidIntentoUpdate() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'in_progress' && (
          // Mientras el ensayo está en curso, sólo se pueden guardar respuestas
          changedKeys.hasOnly(['answers']) ||
          // Terminar o abandonar el intento
          (request.resource.data.status in ['completed', 'abandoned'] && isValidFinish())
        );
      }

      // Evita que el cliente falsifique la fecha de término o adelante la
      // liberación de resultados (retención de 3h para Plan Básico).
      function isValidFinish() {
        let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        let sub = userDoc.get('subscription', {});
        // A lapsed/cancelled subscription only gets its `tier` flipped back
        // to 'free' as a side effect of SubscriptionsService.checkCredits()
        // (starting a quiz/ensayo) — some users might not trigger that for a
        // while, so this can't trust `tier` alone or a Free user past their
        // paid endDate could skip the 3h results-retention delay below.
        let tierIsPremium = userDoc.get('plan', 'free') == 'premium' || sub.get('tier', 'free') == 'premium';
        let endDate = sub.get('endDate', null);
        let notExpired = endDate == null || (endDate is timestamp && endDate > request.time);
        let isPro = tierIsPremium && notExpired;
        let finishedAt = request.resource.data.finishedAt;

        let finishedAtOk = finishedAt is timestamp &&
          finishedAt <= request.time + duration.value(2, 'm') &&
          finishedAt >= request.time - duration.value(10, 'm');

        let availabilityOk = isPro || !('resultsAvailableAt' in request.resource.data) || (
          request.resource.data.resultsAvailableAt is timestamp &&
          request.resource.data.resultsAvailableAt >= finishedAt + duration.value(3, 'h') - duration.value(2, 'm')
        );

        return finishedAtOk && availabilityOk;
      }
    }
    
    // ============ PROGRESO ============
    match /progreso/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // ============ MÓDULOS (legacy) ============
    match /modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /topics/{topicId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ============ LEARNING PATH (NUEVO) ============
    match /lp_materias/{materiaId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /lp_capitulos/{capituloId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{path=**}/secciones/{seccionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /lp_tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ RECURSOS ADICIONALES ============
    match /recursos_adicionales/{recursoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============ ADMINS ============
    match /admins/{adminId} {
      // Un usuario solo puede leer su propio doc (para saber si es admin);
      // los admins pueden leer cualquiera. Evita que cualquier usuario
      // autenticado pueda enumerar todos los UIDs con privilegios de admin.
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if false; // Solo se puede agregar admins manualmente
    }

    // ============ NOTICIAS ============
    match /news/{newsId} {
      // Todo el público puede leer noticias (necesario para el landing page sin autenticar)
      allow read: if true;
      // Solo admins pueden crear/editar noticias
      allow write: if isAdmin();
    }

    // ============ BUG REPORTS ============
    match /bug_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}

