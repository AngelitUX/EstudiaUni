{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend-app",
        "start",
        "--",
        "--port",
        "4301"
      ],
      "port": 4301,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start:dev"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "dist-produccion",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "frontend-app/dist/frontend-app/browser",
        "-p",
        "4320",
        "-c-1",
        "--silent"
      ],
      "port": 4320,
      "autoPort": false
    }
  ]
}
